%% =========================================================
%  HE THONG LOC NHIEU VA PHAN TICH TIN HIEU ECG
%  Bo loc: IIR Butterworth Bandpass + IIR Notch 50 Hz
%  Phat hien dinh R: Thuat toan Pan-Tompkins (don gian hoa)
%  Du lieu: MIT-BIH Arrhythmia Database - Record 100
% =========================================================

clc; clear; close all;

%% ---- 1. DOC DU LIEU VA TIEN XU LY ----
[ecg_raw, fs] = read_mitbih('100');

% MIT-BIH luu xen ke 2 kenh: lay mau le = kenh 1 (MLII)
ecg_ch1 = ecg_raw(1:2:end);

duration = 10;                    % Thoi luong phan tich (giay)
N        = duration * fs;         % Tong so mau
ecg_seg  = ecg_ch1(1:N);
t        = (0:N-1)' / fs;         % Truc thoi gian (s)

% Chuyen doi ADC -> mV (gain=200, baseline=1024 theo chuan MIT-BIH)
gain     = 200;
baseline = 1024;
ecg_clean = (ecg_seg - baseline) / gain;

rng(42);
noise_bw  = 0.15 * sin(2*pi*0.3*t);
noise_emg = 0.03 * randn(N, 1);
ecg_noisy = ecg_clean + noise_bw + noise_pl + noise_emg;

iir_order = 4;
fcut      = [0.5 40] / (fs/2);
[b_iir, a_iir] = butter(iir_order, fcut, 'bandpass');

wo_notch  = 50 / (fs/2);
bw_notch  = wo_notch / 35;
[b_notch, a_notch] = iirnotch(wo_notch, bw_notch);

ecg_iir    = filtfilt(b_iir,   a_iir,   ecg_noisy);
ecg_series = filtfilt(b_notch, a_notch, ecg_iir);

NFFT   = 2^nextpow2(N);
f_axis = (0:NFFT/2-1)' * fs / NFFT;

Y_clean  = 2 * abs(fft(ecg_clean,  NFFT)) / N;
Y_noisy  = 2 * abs(fft(ecg_noisy,  NFFT)) / N;
Y_iir    = 2 * abs(fft(ecg_iir,    NFFT)) / N;
Y_series = 2 * abs(fft(ecg_series, NFFT)) / N;

sig_power  = mean(ecg_clean .^ 2);

snr_before = 10 * log10(sig_power / mean((ecg_noisy  - ecg_clean).^2));
snr_iir    = 10 * log10(sig_power / mean((ecg_iir    - ecg_clean).^2));
snr_series = 10 * log10(sig_power / mean((ecg_series - ecg_clean).^2));

[H_iir,   w_iir  ] = freqz(b_iir,   a_iir,   2048, fs);
[H_notch, w_notch2] = freqz(b_notch, a_notch, 2048, fs);

d_ecg = diff(ecg_series);
d_ecg = [d_ecg(1); d_ecg];

sq_ecg = d_ecg .^ 2;

win_size = round(0.15 * fs);
mwa_ecg  = movmean(sq_ecg, win_size);

thresh   = 0.35 * max(mwa_ecg);
min_dist = round(0.25 * fs);
[~, r_locs] = findpeaks(mwa_ecg, ...
    'MinPeakHeight',   thresh, ...
    'MinPeakDistance', min_dist);

if length(r_locs) < 2
    error('Khong du dinh R. Kiem tra lai tin hieu dau vao.');
end

rr_sec  = diff(r_locs) / fs;
hr_inst = 60 ./ rr_sec;
hr_mean = mean(hr_inst);
hr_std  = std(hr_inst);

figure(1);
set(gcf, 'Name', 'So sanh tin hieu ECG - Mien thoi gian', ...
    'Position', [30 30 1300 750]);

subplot(3,1,1);
plot(t, ecg_clean, 'b', 'LineWidth', 1.2);
title('1. Tin hieu ECG goc - Record 100 MLII (MIT-BIH), da chuyen doi sang mV');
xlabel('Thoi gian (s)'); ylabel('Bien do (mV)');
xlim([0 duration]); grid on;

subplot(3,1,2);
plot(t, ecg_noisy, 'r', 'LineWidth', 0.8);
title(sprintf(['2. ECG sau khi them nhieu ' ...
    '(Baseline Wander 0.3Hz + Luoi dien 50Hz + EMG)  |  SNR = %.2f dB'], ...
    snr_before));
xlabel('Thoi gian (s)'); ylabel('Bien do (mV)');
xlim([0 duration]); grid on;

subplot(3,1,3);
plot(t, ecg_clean,  'b',   'LineWidth', 1.8); hold on;
plot(t, ecg_series, 'r--', 'LineWidth', 1.2);
legend('ECG goc', 'ECG sau loc (IIR Butterworth + Notch)');
title(sprintf('3. So sanh ECG goc vs ECG da loc  |  SNR = %.2f dB', snr_series));
xlabel('Thoi gian (s)'); ylabel('Bien do (mV)');
xlim([0 duration]); grid on;

figure(2);
set(gcf, 'Name', 'Phan tich pho tan so - FFT', ...
    'Position', [30 30 1300 600]);

subplot(2,2,1);
plot(f_axis, Y_clean(1:NFFT/2), 'b', 'LineWidth', 1.2);
title('Pho FFT: ECG goc');
xlabel('Tan so (Hz)'); ylabel('Bien do');
xlim([0 100]); grid on;

subplot(2,2,2);
plot(f_axis, Y_noisy(1:NFFT/2), 'r', 'LineWidth', 1.2);
title('Pho FFT: ECG co nhieu');
xlabel('Tan so (Hz)'); ylabel('Bien do');
xlim([0 100]); grid on;

subplot(2,2,3);
plot(f_axis, Y_iir(1:NFFT/2), 'g', 'LineWidth', 1.2);
title(sprintf('Pho FFT: Sau loc IIR Butterworth  |  SNR = %.2f dB', snr_iir));
xlabel('Tan so (Hz)'); ylabel('Bien do');
xlim([0 100]); grid on;

subplot(2,2,4);
plot(f_axis, Y_series(1:NFFT/2), 'm', 'LineWidth', 1.2);
title(sprintf('Pho FFT: Sau loc IIR Butterworth + Notch  |  SNR = %.2f dB', snr_series));
xlabel('Tan so (Hz)'); ylabel('Bien do');
xlim([0 100]); grid on;

figure(3);
set(gcf, 'Name', 'Dap ung tan so cac bo loc IIR', ...
    'Position', [30 30 1100 480]);

subplot(1,2,1);
plot(w_iir, 20*log10(abs(H_iir) + eps), 'r', 'LineWidth', 1.8);
title(sprintf('IIR Butterworth Bandpass\n(Bac %d  |  fc = [0.5, 40] Hz)', iir_order));
xlabel('Tan so (Hz)'); ylabel('Bien do (dB)');
xlim([0 fs/2]); ylim([-100 5]); grid on;

subplot(1,2,2);
plot(w_notch2, 20*log10(abs(H_notch) + eps), 'm', 'LineWidth', 1.8);
title('IIR Notch Filter  (fo = 50 Hz  |  Q = 35)');
xlabel('Tan so (Hz)'); ylabel('Bien do (dB)');
xlim([0 fs/2]); ylim([-100 5]); grid on;

figure(4);
set(gcf, 'Name', 'Gian do diem Cuc - diem Khong (Pole-Zero Plot)', ...
    'Position', [30 30 1000 480]);

subplot(1,2,1);
zplane(b_iir, a_iir);
title('Gian do Cuc-Khong: IIR Butterworth Bandpass (Bac 4)');

subplot(1,2,2);
zplane(b_notch, a_notch);
title('Gian do Cuc-Khong: IIR Notch 50 Hz');

figure(5);
set(gcf, 'Name', 'Cac buoc phat hien dinh R (Pan-Tompkins)', ...
    'Position', [30 30 1300 780]);

subplot(4,1,1);
plot(t, ecg_series, 'b', 'LineWidth', 1.2);
title('Buoc 1: ECG sau loc (IIR Butterworth + Notch) - Dau vao bo phat hien');
xlabel('Thoi gian (s)'); ylabel('mV');
xlim([0 duration]); grid on;

subplot(4,1,2);
plot(t, d_ecg, 'g', 'LineWidth', 1);
title('Buoc 2: Vi phan  y''(n) = y(n) - y(n-1)  [Lam noi bat doc doc song QRS]');
xlabel('Thoi gian (s)');
xlim([0 duration]); grid on;

subplot(4,1,3);
plot(t, sq_ecg, 'r', 'LineWidth', 1);
title('Buoc 3: Binh phuong  z(n) = y''(n)^2  [Am -> duong, khuyech dai dinh R]');
xlabel('Thoi gian (s)');
xlim([0 duration]); grid on;

subplot(4,1,4);
plot(t, mwa_ecg, 'm', 'LineWidth', 1.2); hold on;
plot([t(1) t(end)], [thresh thresh], 'k--', 'LineWidth', 2);
plot(t(r_locs), mwa_ecg(r_locs), 'rv', 'MarkerSize', 9, 'MarkerFaceColor', 'r');
title(sprintf('Buoc 4: Tich phan cua so truot (MWI, 150ms) + Nguong + Phat hien %d dinh R', ...
    length(r_locs)));
xlabel('Thoi gian (s)');
xlim([0 duration]);
legend('MWI', sprintf('Nguong (%.4f)', thresh), 'Dinh R');
grid on;

figure(6);
set(gcf, 'Name', 'Ket qua cuoi cung: ECG da loc va cac dinh R', ...
    'Position', [30 30 1300 520]);

plot(t, ecg_series, 'b', 'LineWidth', 1.2); hold on;
plot(t(r_locs), ecg_series(r_locs), 'rv', 'MarkerSize', 11, 'MarkerFaceColor', 'r');
title(sprintf(['Ket qua cuoi: ECG da loc (IIR+Notch)  |  %d dinh R  |  ' ...
    'Nhip tim TB: %.1f +/- %.1f bpm'], ...
    length(r_locs), hr_mean, hr_std));
xlabel('Thoi gian (s)'); ylabel('Bien do (mV)');
legend('ECG da loc', sprintf('Dinh R (%d dinh)', length(r_locs)));
xlim([0 duration]); grid on;

figure(7);
set(gcf, 'Name', 'Nhip tim tuc thoi theo thoi gian', ...
    'Position', [30 30 950 420]);

t_hr = t(r_locs(2:end));
plot(t_hr, hr_inst, 'bo-', 'LineWidth', 1.8, 'MarkerSize', 7, ...
    'MarkerFaceColor', 'b'); hold on;
plot([t_hr(1) t_hr(end)], [hr_mean hr_mean], 'r--', 'LineWidth', 2);
title(sprintf('Nhip tim tuc thoi  |  Trung binh = %.1f bpm  |  Do lech chuan = %.1f bpm', ...
    hr_mean, hr_std));
xlabel('Thoi gian (s)'); ylabel('Nhip tim (bpm)');
legend('Nhip tim tuc thoi', sprintf('Trung binh: %.1f bpm', hr_mean));
ylim([40 120]); grid on;

fprintf('   KET QUA PHAN TICH TIN HIEU ECG\n');
fprintf('  Tan so lay mau  (fs)  : %d Hz\n',      fs);
fprintf('  Thoi luong phan tich  : %d giay\n',     duration);
fprintf('  So mau phan tich  (N) : %d mau\n',      N);
fprintf('  Do phan giai pho (df) : %.4f Hz\n',     fs/NFFT);
fprintf('  SNR truoc loc                : %7.2f dB\n', snr_before);
fprintf('  SNR sau loc IIR Butterworth  : %7.2f dB\n', snr_iir);
fprintf('  SNR sau loc IIR + Notch      : %7.2f dB\n', snr_series);
fprintf('  So dinh R phat hien    : %d dinh\n',    length(r_locs));
fprintf('  Khoang RR trung binh   : %.3f giay\n',  mean(rr_sec));
fprintf('  Nhip tim trung binh    : %.1f bpm\n',   hr_mean);
fprintf('  Do lech chuan nhip tim : %.1f bpm\n',   hr_std);
